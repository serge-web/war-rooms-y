# Backend Configuration
VITE_BACKEND_MODE=mock  # or 'openfire'

# Mock Backend Settings
VITE_MOCK_PERSISTENCE=localStorage  # or 'indexedDB' or 'memory'
VITE_MOCK_DEBUG=true
VITE_MOCK_LATENCY=100  # Simulate network delay (ms)

# OpenFire Backend Settings (when VITE_BACKEND_MODE=openfire)
VITE_OPENFIRE_WS=wss://your-openfire-server.com:7443/ws
VITE_OPENFIRE_DOMAIN=wargame.local
VITE_OPENFIRE_CONFERENCE=conference.wargame.local
VITE_OPENFIRE_PUBSUB=pubsub.wargame.local

# Application Settings
VITE_APP_TITLE=War Rooms Y
VITE_APP_VERSION=0.1.0

# Feature Flags
VITE_ENABLE_FORMS=true
VITE_ENABLE_METADATA=true
VITE_ENABLE_ADMIN_UI=true

# Development Settings
VITE_DEV_PORT=5173
VITE_STORYBOOK_PORT=6006
